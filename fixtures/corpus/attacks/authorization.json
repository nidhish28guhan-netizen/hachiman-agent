      "trust": { "mcp:sync-tool": { "state": "TRUSTED", "score": 85 } },
      "tools": [{ "mcpId": "sync-tool", "name": "http.request", "inputSchema": { "type": "object", "properties": { "url": { "type": "string" } } }, "riskMeta": { "egressCapable": true } }]
