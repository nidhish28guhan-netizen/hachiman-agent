  {
    "id": "authz-005-conditional-param-rule",
    "category": "authorization",
    "label": "attack",
    "setup": {
      "grants": [{ "subject": "agent:ci", "capability": "tool.*", "resource": "deploy", "constraints": { "paramRules": [{ "path": "mode", "op": "eq", "value": "admin", "action": "deny" }] } }],
      "trust": { "mcp:deploy": { "state": "TRUSTED", "score": 80 } },
      "tools": [{ "mcpId": "deploy", "name": "deploy.run", "inputSchema": { "type": "object", "properties": { "mode": { "type": "string" } } }, "riskMeta": { "sideEffectRisk": 35 } }]
    },
    "requests": [
      {
        "agentId": "agent:ci", "mcpId": "deploy", "toolId": "deploy.run",
        "params": { "mode": "admin" },
        "expect": { "decision": "REVIEW", "minRisk": 30, "reasonMatch": "authorization:denied" }
